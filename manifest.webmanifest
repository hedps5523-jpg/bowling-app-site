    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "클럽관리", "url": "/club?source=app", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "기록 조회", "url": "/records?source=app", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
